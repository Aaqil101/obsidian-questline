{
	"name": "obsidian-questline",
	"version": "0.1.0",
	"description": "Track goals and projects in plain Markdown, with task progress rolling up from projects to goals.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"verify:vault": "vitest run src/verify"
	},
	"keywords": [],
	"license": "GPL-3.0-or-later",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.14.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.7",
		"yaml": "^2.9.1"
	},
	"allowScripts": {
		"esbuild@0.25.5": true,
		"esbuild@0.28.2": true
	}
}
